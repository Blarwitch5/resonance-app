# Copy to .env.local — never commit secrets.
# Generate BETTER_AUTH_SECRET: openssl rand -base64 32

# Neon Postgres — local must be a *dev/test* branch, never production.
# Production DATABASE_URL lives only in Vercel → Environment Variables.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth (secret: min 32 characters)
BETTER_AUTH_SECRET="replace-with-a-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Vercel → Project → Settings → Environment Variables
# Set DATABASE_URL, BETTER_AUTH_SECRET, Discogs keys for Production and Preview
# (Build + Runtime). Redeploy after saving — a running build will not pick them up.
# BETTER_AUTH_URL: the public https origin (custom domain, or https://<project>.vercel.app).
# On Vercel it can be omitted: the deployment URL is used. Set it once you have a domain.
# BLOB_READ_WRITE_TOKEN: injected when you connect a Blob store to the project.

# Discogs — https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY="your_discogs_consumer_key"
DISCOGS_CONSUMER_SECRET="your_discogs_consumer_secret"

# Resend — https://resend.com/api-keys (password reset letters; needs a verified domain)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Resonance <hello@yourdomain.com>"

# Vercel Blob — portraits. On Vercel: Storage → Blob → connect the project
# (BLOB_READ_WRITE_TOKEN is injected). Locally: paste the token from that store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token"

NODE_ENV="development"

# Copy to .env.local — never commit secrets.
# Generate BETTER_AUTH_SECRET: openssl rand -base64 32

# Neon Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth (secret: min 32 characters)
BETTER_AUTH_SECRET="replace-with-a-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Discogs — https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY="your_discogs_consumer_key"
DISCOGS_CONSUMER_SECRET="your_discogs_consumer_secret"

# Resend — https://resend.com/api-keys (password reset letters; needs a verified domain)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Resonance <hello@yourdomain.com>"

NODE_ENV="development"
